for fn,repl in P.items():
 p=Path(fn)
 with p.open(encoding="utf-8-sig",newline="") as f:r=list(csv.DictReader(f)); fields=list(r[0])
 d={x["Tag"]:x for x in r}
 missing=set(repl)-set(d)
 if missing: raise SystemExit(f"{fn} missing tags: {sorted(missing)}")
 n=0
 for tag,v in repl.items():
  if d[tag]["German"]!=v:d[tag]["German"]=v;n+=1
 if n!=len(repl):raise SystemExit(f"{fn} expected {len(repl)} changes, got {n}")
 with p.open("w",encoding="utf-8-sig",newline="") as f:
  w=csv.DictWriter(f,fieldnames=fields);w.writeheader();w.writerows(r)
 print(fn,n)
